# Vitreo · local environment
# Copy to .env and change every password. .env is never committed.
# Every app reads this single file from the repository root.

# ── Mosquitto (infra/docker-compose.yml) ─────────────────────────────
# Three users with an ACL (infra/mosquitto/acl):
#   device  the ESP32 and the simulator
#   hub     the hub service
#   web     the web app (its password ends up in the browser bundle)
MQTT_DEVICE_PASSWORD=change-me-device
MQTT_HUB_PASSWORD=change-me-hub
MQTT_WEB_PASSWORD=change-me-web

# Host ports for the broker listeners. WebSocket uses 9002, not the usual
# 9001, to avoid clashing with MinIO from another local project.
MQTT_PORT=1883
MQTT_WS_PORT=9002
# Local nginx serving the built PWA, published by Tailscale Serve (docs/05).
WEB_PORT=8080

# ── Simulator (apps/simulator) ───────────────────────────────────────
# Connects as the `device` user with MQTT_DEVICE_PASSWORD.
SIMULATOR_DEVICE_ID=sim
SIMULATOR_MQTT_URL=mqtt://localhost:1883
# Development-only HTTP API to force scenarios (127.0.0.1 only).
SIMULATOR_CONTROL_PORT=8788
# Speeds up slow processes (soil drying, air). 1 = real time; 60 = an hour per minute.
SIMULATOR_TIME_SCALE=1
# Optional JSON file overriding physical parameters (see apps/simulator/src/model/params.ts).
# SIMULATOR_PARAMS=apps/simulator/params.local.json

# ── Hub (apps/hub) ───────────────────────────────────────────────────
# Runs in Docker (`pnpm infra:up`), published on 127.0.0.1 only (D74); the
# phone reaches it at /api through nginx and Tailscale Serve.
HUB_PORT=8787
# The greenhouse whose history and config this hub owns (the simulator is
# `sim`; later the ESP32's id).
HUB_DEVICE_ID=sim
# Time zone for daily summaries, the nightly backup (03:00) and the device's
# schedules.
HUB_TZ=Europe/Madrid
# `pnpm --filter @vitreo/hub dev` runs a separate dev hub: its own database
# (data/hub-dev/), its own greenhouse (`dev`) and this port. It never opens
# the Docker hub's database nor publishes its config.
HUB_HOST=127.0.0.1
HUB_DEV_PORT=8797

# Web push (A7): a key pair made once with `pnpm hub:vapid`, only here.
# Without it the hub keeps warnings but sends no notifications. Changing it
# means turning warnings on again on every device.
HUB_VAPID_PUBLIC_KEY=
HUB_VAPID_PRIVATE_KEY=
# Who sends them, for the push services.
HUB_VAPID_SUBJECT=mailto:vitreo@localhost
LOG_LEVEL=info

# Outdoor weather (A10): a free AEMET OpenData key, only here
# (https://opendata.aemet.es/centrodedescargas/altaUsuario). Without it the
# hub fetches nothing and the app shows no weather. After adding or changing
# it: `pnpm infra:up` (the hub picks it up).
AEMET_API_KEY=
# Municipality for the hourly forecast (INE code): Madrid.
AEMET_MUNICIPIO=28079
# Station to observe (AEMET idema). Empty: the nearest to the greenhouse's
# location (Ajustes › Ubicación), chosen by the hub.
AEMET_ESTACION=

# ── Web (apps/web) ───────────────────────────────────────────────────
# VITE_* values are public: they are bundled into the app. Never put the
# device or hub password here.
VITE_MQTT_URL=ws://localhost:9002
# Served over HTTPS (Tailscale), the app uses wss://<same host>:8443 unless this is set.
# VITE_MQTT_URL_SECURE=wss://vitreo.<tailnet>.ts.net:8443
VITE_MQTT_USERNAME=web
# Must match MQTT_WEB_PASSWORD.
VITE_MQTT_PASSWORD=change-me-web
# Device whose topics the app follows (the simulator is `sim`).
VITE_DEVICE_ID=sim
# The hub's API, same origin as the app (Vite proxies it in development,
# nginx in production).
VITE_API_URL=/api
# Where the greenhouse is: day and night follow the real sun there. Put the
# real place only in .env, rounded to 2 decimals; the repository keeps the
# centre of Madrid (D79).
VITE_LOCATION_LAT=40.42
VITE_LOCATION_LNG=-3.70
