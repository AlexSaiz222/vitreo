{
  "name": "@vitreo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json",
    "e2e": "playwright test watering.spec.ts boot.spec.ts interface.spec.ts settings.spec.ts hub.spec.ts history.spec.ts automations.spec.ts alerts.spec.ts a8.spec.ts a9.spec.ts a10.spec.ts --grep-invert @capture",
    "e2e:full": "playwright test",
    "capture": "playwright test captures.spec.ts",
    "pwa:check": "playwright test --config playwright.pwa.config.ts",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "demo:week": "tsx scripts/demo-week.ts",
    "video:landing": "node scripts/landing-video.mjs",
    "video:trailer": "node scripts/trailer-footage.mjs",
    "notebook:shots": "node scripts/notebook-shots.mjs",
    "icons": "node scripts/render-icons.mjs",
    "perf": "playwright test perf.spec.ts --workers 1",
    "models:jsx": "node scripts/model-jsx.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@vitreo/hub": "workspace:*",
    "@vitreo/shared": "workspace:*",
    "@vitreo/sim-core": "workspace:*",
    "mqtt": "^5.16.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "1.14.2",
    "suncalc": "^2.0.2",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gltfjsx": "^6.5.3",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
