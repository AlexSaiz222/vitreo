{
  "name": "vitreo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @vitreo/web e2e",
    "e2e:full": "pnpm --filter @vitreo/web e2e:full",
    "capture": "pnpm --filter @vitreo/web capture",
    "pwa:check": "pnpm --filter @vitreo/web pwa:check",
    "e2e:demo": "pnpm --filter @vitreo/web e2e:demo",
    "release": "node scripts/release.mjs",
    "status": "node scripts/status.mjs",
    "demo:dev": "pnpm --filter @vitreo/web exec vite --mode demo",
    "demo:week": "pnpm --filter @vitreo/web demo:week",
    "video:landing": "pnpm --filter @vitreo/web video:landing",
    "video:trailer": "pnpm --filter @vitreo/web video:trailer",
    "notebook:shots": "pnpm --filter @vitreo/web notebook:shots",
    "demo:build": "node scripts/demo.mjs build",
    "demo:release": "node scripts/demo.mjs release",
    "sim:week": "pnpm --filter @vitreo/simulator week",
    "boot:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/boot-task.ps1",
    "boot:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/boot-task.ps1 -Remove",
    "models:export": "node assets/scripts/export-blender.mjs",
    "models": "node assets/scripts/optimize-models.mjs",
    "models:jsx": "pnpm --filter @vitreo/web models:jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --no-build",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "broker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d mosquitto",
    "broker:down": "docker compose --env-file .env -f infra/docker-compose.yml stop mosquitto",
    "broker:check": "pnpm --filter @vitreo/simulator broker:check",
    "broker:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f mosquitto",
    "hub:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f hub",
    "hub:backup": "node infra/hub/backup.mjs",
    "hub:restore": "node infra/hub/restore.mjs",
    "hub:vapid": "pnpm --filter @vitreo/hub exec tsx src/cli/vapid.ts",
    "prepare": "simple-git-hooks",
    "fonts": "node assets/scripts/subset-fonts.mjs",
    "audio": "node assets/scripts/build-audio.mjs",
    "notebook:images": "node assets/scripts/notebook-images.mjs"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "preserveUnused": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "ffmpeg-static": "^5.3.0",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "subset-font": "^2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
